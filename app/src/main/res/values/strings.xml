    <!-- Onboarding — Step 1: Welcome (TSD Section 2.1) -->
    <string name="welcome_headline">Fast voice typing, powered by Groq AI</string>
    <string name="welcome_subtitle">Sensum enables lightning-fast voice typing powered by Groq\'s Whisper transcription.</string>
    <string name="welcome_supporting_line">One-time setup • Secure key storage • Premium voice-first design</string>
    <string name="btn_get_started">Get Started</string>
    <string name="permission_audio_rationale">Microphone access is required to record your voice for transcription.</string>
    <string name="permission_notification_rationale">Notification permission is required to show hands-free recording status.</string>

    <!-- Onboarding — Step 2: API Key (TSD Section 2.1) -->
    <string name="api_key_headline">Enter your free Groq API Key</string>
    <string name="api_key_subtitle">It\'s completely free and takes just a minute. Copy and paste it below to unlock the power of Sensum.</string>
    <string name="api_key_hint">gsk_…</string>
    <string name="api_key_help_link">How do I get a free API key?</string>
    <string name="api_key_steps_title">Free one-time setup (about 60 seconds)</string>
    <string name="api_key_steps_body">1. Open console.groq.com/keys\n2. Sign in or create a free Groq account\n3. Tap \"Create API Key\"\n4. Copy the key that starts with gsk_ and paste it here</string>
    <string name="api_key_one_time_note">You only do this once on this phone. Sensum saves it securely, so your friends and family won\'t need to repeat setup every time.</string>
    <string name="api_key_validating">Validating key…</string>
    <string name="api_key_valid">API key is valid ✓</string>
    <string name="api_key_error_format">Invalid format. Key must start with gsk_ followed by 40+ characters.</string>
