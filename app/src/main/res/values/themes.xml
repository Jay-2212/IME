<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GroqVoiceKeyboard" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Obsidian Ember semantic mapping -->
        <item name="colorPrimary">@color/oe_accent</item>
        <item name="colorOnPrimary">@color/on_accent_primary</item>
        <item name="colorPrimaryContainer">@color/oe_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_primary</item>

        <item name="colorSecondary">@color/oe_accent_soft</item>
        <item name="colorOnSecondary">@color/on_accent_secondary</item>
        <item name="colorSecondaryContainer">@color/oe_surface_2</item>
        <item name="colorOnSecondaryContainer">@color/oe_text_primary</item>

        <item name="colorSurface">@color/oe_surface</item>
        <item name="colorSurfaceVariant">@color/oe_surface_2</item>
        <item name="colorOnSurface">@color/oe_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/oe_text_secondary</item>
        <item name="colorOutline">@color/oe_outline</item>

        <item name="colorError">@color/oe_error</item>
        <item name="colorOnError">@color/on_error</item>

        <item name="android:colorBackground">@color/oe_bg_0</item>
        <item name="android:windowBackground">@color/oe_bg_0</item>
        <item name="android:textColorPrimary">@color/oe_text_primary</item>
        <item name="android:textColorSecondary">@color/oe_text_secondary</item>

        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GroqVoiceKeyboard.MediumComponent</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.GroqVoiceKeyboard.SmallComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.GroqVoiceKeyboard.LargeComponent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.GroqVoiceKeyboard</item>
    </style>

    <style name="Theme.GroqVoiceKeyboard.Pastel" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/pp_accent</item>
        <item name="colorOnPrimary">@color/pp_on_accent</item>
        <item name="colorPrimaryContainer">@color/pp_accent_soft</item>
        <item name="colorOnPrimaryContainer">@color/pp_on_accent</item>

        <item name="colorSecondary">@color/pp_accent_soft</item>
        <item name="colorOnSecondary">@color/pp_on_accent</item>
        <item name="colorSecondaryContainer">@color/pp_surface_2</item>
        <item name="colorOnSecondaryContainer">@color/pp_text_primary</item>

        <item name="colorSurface">@color/pp_surface</item>
        <item name="colorSurfaceVariant">@color/pp_surface_2</item>
        <item name="colorOnSurface">@color/pp_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/pp_text_secondary</item>
        <item name="colorOutline">@color/pp_outline</item>

        <item name="colorError">@color/pp_error</item>
        <item name="colorOnError">@color/pp_on_error</item>

        <item name="android:colorBackground">@color/pp_bg_0</item>
        <item name="android:windowBackground">@color/pp_bg_0</item>
        <item name="android:textColorPrimary">@color/pp_text_primary</item>
        <item name="android:textColorSecondary">@color/pp_text_secondary</item>

        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.GroqVoiceKeyboard.MediumComponent</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.GroqVoiceKeyboard.SmallComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.GroqVoiceKeyboard.LargeComponent</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay.GroqVoiceKeyboard</item>
    </style>

    <!-- Onboarding theme -->
    <style name="Theme.GroqVoiceKeyboard.Onboarding" parent="Theme.GroqVoiceKeyboard">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.GroqVoiceKeyboard.Onboarding.Pastel" parent="Theme.GroqVoiceKeyboard.Pastel">
        <item name="android:windowFullscreen">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Settings theme -->
    <style name="Theme.GroqVoiceKeyboard.Settings" parent="Theme.GroqVoiceKeyboard">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/oe_bg_0</item>
    </style>

    <style name="Theme.GroqVoiceKeyboard.Settings.Pastel" parent="Theme.GroqVoiceKeyboard.Pastel">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowBackground">@color/pp_bg_0</item>
    </style>

    <style name="PreferenceThemeOverlay.GroqVoiceKeyboard" parent="PreferenceThemeOverlay.v14.Material">
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>
        <item name="android:textColorSecondary">?attr/colorOnSurfaceVariant</item>
        <item name="preferenceCategoryTitleTextAppearance">@style/TextAppearance.GroqVoiceKeyboard.PreferenceCategory</item>
        <item name="preferenceCategoryTitleTextColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.GroqVoiceKeyboard.PreferenceCategory" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="TextAppearance.GroqVoiceKeyboard.PreferenceTitle" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="TextAppearance.GroqVoiceKeyboard.PreferenceSummary" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Shape appearance for rounded components -->
    <style name="ShapeAppearance.GroqVoiceKeyboard.MediumComponent" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">@dimen/oe_radius_md</item>
    </style>

    <style name="ShapeAppearance.GroqVoiceKeyboard.SmallComponent" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerSize">@dimen/oe_radius_sm</item>
    </style>

    <style name="ShapeAppearance.GroqVoiceKeyboard.LargeComponent" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerSize">@dimen/oe_radius_lg</item>
    </style>

    <!-- Mic button style -->
    <style name="Widget.GroqVoiceKeyboard.MicButton" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="tint">?attr/colorOnPrimary</item>
        <item name="elevation">@dimen/mic_button_elevation</item>
        <item name="maxImageSize">@dimen/mic_icon_size</item>
    </style>

    <!-- Primary action button (onboarding) -->
    <style name="Widget.GroqVoiceKeyboard.PrimaryButton" parent="Widget.Material3.Button">
        <item name="backgroundTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="cornerRadius">@dimen/onboarding_button_corner_radius</item>
        <item name="android:minHeight">@dimen/onboarding_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
