<?xml version="1.0" encoding="utf-8"?>
<!--
    Network security configuration.
    Enforces HTTPS for all connections in both debug and release.
    Certificate pinning for api.groq.com can be added here (Section 7.1).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!--
    Uncomment and populate with Groq's certificate SHA-256 pins when implementing
    certificate pinning (TSD Section 7.1 - optional security enhancement):

    <domain-config>
        <domain includeSubdomains="false">api.groq.com</domain>
        <pin-set>
            <pin digest="SHA-256">REPLACE_WITH_ACTUAL_PIN=</pin>
            <pin digest="SHA-256">REPLACE_WITH_BACKUP_PIN=</pin>
        </pin-set>
    </domain-config>
    -->
</network-security-config>
