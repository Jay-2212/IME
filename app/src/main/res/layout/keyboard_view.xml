<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/keyboard_root"
    android:layout_width="match_parent"
    android:layout_height="@dimen/keyboard_height"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/keyboard_padding_horizontal"
    android:paddingVertical="@dimen/keyboard_padding_vertical">

    <!-- Zone A: banner + preview + state -->
    <LinearLayout
        android:id="@+id/status_zone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/oe_space_3"
            android:paddingTop="@dimen/oe_space_1"
            android:paddingBottom="@dimen/oe_space_1">

            <TextView
                android:id="@+id/banner_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/colorError"
                android:gravity="center"
                android:paddingHorizontal="@dimen/oe_space_2"
                android:paddingVertical="@dimen/oe_space_1"
                android:textColor="?attr/colorOnError"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Tap to configure API key"
                tools:visibility="visible" />

            <HorizontalScrollView
                android:id="@+id/transcription_preview_container"
                android:layout_width="match_parent"
                android:layout_height="@dimen/transcription_preview_height"
                android:layout_marginTop="@dimen/oe_space_1"
                android:scrollbars="none"
                android:visibility="gone"
                tools:visibility="visible">

                <TextView
                    android:id="@+id/transcription_preview_text"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="@dimen/text_body"
                    tools:text="Transcription preview will appear here…" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/state_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/oe_space_1"
                android:gravity="center"
                android:textColor="?attr/colorOnSurface"
                android:textSize="@dimen/text_label"
                tools:text="Ready" />
        </LinearLayout>
    </LinearLayout>

    <!-- Zone B: middle row containing settings chip, hero mic, and enter/action key -->
    <FrameLayout
        android:id="@+id/mic_zone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/keyboard_zone_gap"
        android:layout_weight="1"
        android:minHeight="@dimen/mic_zone_min_height">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="@dimen/action_rail_key_width"
            android:layout_height="@dimen/key_height"
            android:layout_gravity="center_vertical|start"
            android:contentDescription="@string/tooltip_settings"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:minHeight="@dimen/touch_target_min"
            android:minWidth="@dimen/touch_target_min"
            android:padding="0dp"
            android:text=""
            app:cornerRadius="@dimen/key_corner_radius"
            app:icon="@drawable/ic_key_settings"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/key_icon_size" />

        <View
            android:id="@+id/mic_pulse_layer"
            android:layout_width="@dimen/mic_pulse_diameter"
            android:layout_height="@dimen/mic_pulse_diameter"
            android:layout_gravity="center"
            android:alpha="0"
            android:background="@drawable/bg_mic_pulse" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/btn_mic"
            style="@style/Widget.GroqVoiceKeyboard.MicButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:contentDescription="@string/key_mic_description"
            app:backgroundTint="?attr/colorPrimary"
            app:elevation="@dimen/mic_button_elevation"
            app:fabCustomSize="@dimen/mic_button_diameter"
            app:maxImageSize="@dimen/mic_icon_size"
            app:srcCompat="@drawable/ic_mic_material" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_enter"
            android:layout_width="@dimen/action_rail_key_width"
            android:layout_height="@dimen/key_height"
            android:layout_gravity="center_vertical|end"
            android:contentDescription="@string/key_enter_description"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:minHeight="@dimen/touch_target_min"
            android:minWidth="@dimen/touch_target_min"
            android:padding="0dp"
            android:text="@string/key_enter_default"
            android:textSize="18sp"
            app:cornerRadius="@dimen/key_corner_radius"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/key_icon_size" />
    </FrameLayout>

    <!-- Zone C: bottom row containing spacebar and backspace -->
    <LinearLayout
        android:id="@+id/bottom_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/keyboard_zone_gap"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_spacebar"
            android:layout_width="0dp"
            android:layout_height="@dimen/spacebar_height"
            android:layout_weight="1"
            android:contentDescription="@string/key_space_description"
            android:minHeight="@dimen/touch_target_min"
            android:minWidth="0dp"
            android:text="@string/key_space_label"
            android:textAllCaps="false"
            android:textSize="13sp"
            app:cornerRadius="@dimen/key_corner_radius" />

        <Space
            android:layout_width="@dimen/key_row_gap"
            android:layout_height="match_parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_backspace"
            android:layout_width="@dimen/action_rail_key_width"
            android:layout_height="@dimen/key_height"
            android:contentDescription="@string/key_backspace_description"
            android:gravity="center"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:insetTop="0dp"
            android:minHeight="@dimen/touch_target_min"
            android:minWidth="@dimen/touch_target_min"
            android:padding="0dp"
            android:text=""
            app:cornerRadius="@dimen/key_corner_radius"
            app:icon="@drawable/ic_key_backspace"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconSize="@dimen/key_icon_size" />
    </LinearLayout>

</LinearLayout>
