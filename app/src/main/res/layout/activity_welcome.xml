<?xml version="1.0" encoding="utf-8"?>
<!--
    WelcomeActivity host layout.
    Holds the ViewPager2 for the 3-step onboarding flow (TSD Section 2.1).
    Gradient background simulated via a GradientDrawable applied in code.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/onboarding_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/keyboard_background">

    <!-- ViewPager2 — holds 3 onboarding fragments -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/onboarding_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/dot_indicator_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Step dot indicator -->
    <LinearLayout
        android:id="@+id/dot_indicator_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Step dots generated programmatically in WelcomeActivity -->
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
