# Environment Variables — GroqVoice Keyboard
# Copy this file to `.env` (which is gitignored) and fill in your values.
# NOTE: For Android builds, these values are typically passed via local.properties
# or set as CI/CD environment variables and injected at build time via BuildConfig.

# Groq API Key — obtain from https://console.groq.com/keys
# Format: gsk_<40+ alphanumeric characters>
GROQ_API_KEY=gsk_your_api_key_here

# Groq API base URL (default, change only if using a proxy)
GROQ_API_BASE_URL=https://api.groq.com/openai/v1/

# Default transcription model
GROQ_DEFAULT_MODEL=whisper-large-v3-turbo

# Build environment: debug | release
BUILD_ENV=debug
