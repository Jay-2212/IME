# Copy this file to `keystore.properties` and fill with your release signing
# key details. This is a self-managed release key for direct/sideloaded
# distribution, not a Google Play "upload key" (Sensum is not published to
# Play). Never commit the real `keystore.properties`.

storeFile=/absolute/path/to/sensum-release.jks
storePassword=change_me
keyAlias=sensum-release
keyPassword=change_me
